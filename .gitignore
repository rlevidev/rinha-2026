# Binaries for programs
*.exe
*.dll
*.so
*.dylib

# Test binary, generated by `go test -c`
*.test

# Output of the go toolchain
*.out

# Dependency directories (remove the 'vendor' directory if it's not being used)
/vendor/

# Go module cache (usually in ~/.cache/go-build)
.go-build/

# IDE files
.idea/
.vscode/

# Environment variables
.env

# Docker
.dockerignore

# Build output
/build/
/dist/
